# Banco persistente na Vercel: PostgreSQL ou Turso. SQLite em arquivo é somente local.
CRM_DATABASE_PROVIDER=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=
CRM_DB_SCHEMA=crm_development
APP_URL=http://localhost:3000
CRM_BOOTSTRAP_TOKEN=
# WhatsApp oficial — nenhuma mensagem é enviada sem configuração e confirmação.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Armazenamento privado compatível com S3.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CRON_SECRET=
BACKUP_KEY=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Assistente opcional: manter desativado até validar qualidade, conta gratuita e retenção.
CRM_MESSAGE_AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=

# Pré-validação documental: alternativa à configuração privada na ficha Banco DOC.
CRM_DOCUMENT_AI_ENABLED=false
CRM_DOCUMENT_AI_ZDR_CONFIRMED=false
